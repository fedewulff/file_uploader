<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs",{title:"Folder"}) %>
  <body>
    <div class="user-folder-containers">
      <div class="logout-name-delete-container">
        <div class="logout-delete">
          <a href="/logout" class="logout">LOG OUT</a>
          <form action="/folder/<%= folderId %>/delete" method="post" style="display: inline" class="deleteUserForm">
            <button type="submit" onclick="return confirm('Delete this folder?');" class="deleteFolderButton">DELETE FOLDER</button>
          </form>
        </div>
        <h2 class="user-folder-name"><%= folder[0].name %></h2>
      </div>
      <div class="user-folder-content-container">
        <div class="user-filder-sidebar">
          <a href="/user" class="addFolderAndFile">Back</a>
          <a href="/folder/<%= folderId %>/update" class="addFolderAndFile">Update folder</a>
          <a href="/add_file/<%= folderId %>" class="addFolderAndFile">Add file</a>
        </div>

        <div class="grid">
          <% if(files[0]) {%>
          <h3 class="folderFileTitle">Files</h3>
          <div class="folderFileContainer">
            <%for( let i = 0; i < files.length; i++ ) { %>
            <a href="/file/<%= files[i].id %>" class="gridBlock file">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <title>file-document-outline</title>
                <path d="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6M6,4H13V9H18V20H6V4M8,12V14H16V12H8M8,16V18H13V16H8Z" />
              </svg>
              <div class="folderFileName"><%= files[i].name %></div>
            </a>
            <% }%>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
