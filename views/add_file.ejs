<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs",{title:"Add file"}) %>
  <body>
    <div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" xmlns:xlink="http://www.w3.org/1999/xlink" class="go-back">
        <title>arrow-left</title>
        <a xlink:href="javascript:history.back()">
          <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
        </a>
      </svg>
      <form class="addFileForm" action="/add_file/<%= folderId %>" method="post" enctype="multipart/form-data">
        <div>
          <label for="file">File:</label>
          <input type="file" name="file" id="file" required />
        </div>
        <button class="addFileButton" type="submit">Add file</button>
      </form>
    </div>
  </body>
</html>
