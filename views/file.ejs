<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs",{title:"File"}) %>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" xmlns:xlink="http://www.w3.org/1999/xlink" class="go-back">
      <title>arrow-left</title>
      <a xlink:href="javascript:history.back()">
        <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
      </a>
    </svg>

    <div class="fileContainer">
      <div class="fileData">
        <div><%= file.name %></div>
        <div><%= file.createdAt %></div>
        <% if(file.resourceType !== "raw") {%>
        <a href="<%= file.file %>" target="_blank">View file</a>
        <% } %> <% if(file.resourceType === "raw") {%>
        <div class="notVisibleFile">
          <div>View file</div>
          <div>not possible due to file type</div>
        </div>
        <% } %>
        <a href="/file/<%= file.id %>/download">Download</a>
        <div><%= (file.size/1000000).toFixed(2) %> MB</div>
      </div>
      <form action="/file/<%= file.id %>/delete" method="post" class="deleteFileForm">
        <button type="submit" onclick="return confirm('Delete this file?');">Delete file</button>
      </form>
    </div>
  </body>
</html>
